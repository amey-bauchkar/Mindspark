# Warrant — Environment Configuration
# Copy this to .env and adjust values. No secrets are required for core features.

# Set to 1 to use recorded fixture responses instead of live API calls
OFFLINE_FIXTURES=0

# EPSS score threshold for ACT NOW verdict (rule R2)
# Default 0.10; not empirically validated — treat as a starting point
EPSS_THRESHOLD=0.10

# Freshness horizon in hours: packages published within this window get CANNOT ASSESS (new)
FRESHNESS_HOURS=72

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional LLM narrator (leave blank to disable all LLM UI)
LLM_PROVIDER=
LLM_API_KEY=

# SQLite cache path
DB_PATH=warrant_cache.db

# Warrant Watch — continuous monitoring of analysed projects for NEW security evidence
# Set WATCH_ENABLED=0 to switch the feature off entirely (analysis behaves exactly as before)
WATCH_ENABLED=1
# Run the background scheduler inside the API process
WATCH_SCHEDULER_ENABLED=1
# Minutes between live checks of each monitored project (OSV incl. MAL-*, CISA KEV, EPSS)
WATCH_INTERVAL_MINUTES=60
# Seconds between checks of DEMO / REPLAY watches (recorded evidence, simulated clock)
WATCH_REPLAY_INTERVAL_SECONDS=10
# How often the scheduler wakes to look for due checks
WATCH_TICK_SECONDS=5
# Projects checked in parallel per scheduler tick (several API processes may share one database)
WATCH_MAX_CONCURRENT_CHECKS=3

# Notifications sent for EVERY project (in addition to per-project channels set in the UI/API).
# Comma-separated "kind:url" with kind = slack | teams | webhook. Only https URLs to public hosts.
WATCH_NOTIFY_WEBHOOKS=
# HMAC-SHA256 secret used to sign the global generic webhooks (header X-Warrant-Signature)
WATCH_WEBHOOK_SECRET=
# Base URL of the Warrant web UI, used for "View updated analysis" links in notifications
PUBLIC_APP_URL=http://localhost:5173

# Access control. Leave both empty for local single-user use.
# Full access key, and an optional read-only key (GET only). Send as header X-Warrant-Key or Authorization: Bearer.
WARRANT_API_KEY=
WARRANT_READ_KEY=

# Registry metadata (staleness / freshness) is fetched for this many direct dependencies
REGISTRY_FETCH_CAP=50
